{
  "name": "alfajores-erp",
  "version": "1.6.7",
  "description": "Alpha Gestion — ERP de escritorio para fabrica de alfajores (Electron + Fastify + SQLite)",
  "private": true,
  "type": "commonjs",
  "main": "dist/main/arranque.js",
  "author": "Alpha Gestion",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "npm run build:node && node dist/server/db/aplicar-migraciones.js",
    "db:seed": "npm run build:node && node dist/seed/index.js",
    "db:studio": "drizzle-kit studio",
    "start": "npm run build && electron .",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "iconos": "node scripts/generar-iconos.mjs",
    "empaquetar:mac": "npm run build && electron-builder --mac --arm64 --dir",
    "instalar:mac": "node scripts/instalar-mac.mjs",
    "build:win": "npm run build && electron-builder --win --x64 --config electron-builder.win.yml",
    "publicar:mac": "npm run build && electron-builder --mac --arm64 --publish always",
    "publicar:win": "npm run build && electron-builder --win --x64 --config electron-builder.win.yml --publish always"
  },
  "dependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fastify": "^5.11.2",
    "lucide-react": "^1.28.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
